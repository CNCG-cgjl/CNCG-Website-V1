<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- 静态路由 -->
  <url>
    <loc>https://cncg.me/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://cncg.me/note</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://cncg.me/doc</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://cncg.me/shop</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://cncg.me/about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>

  <!--
    动态路由（/note/:slug）需由构建脚本自动生成
    参考：使用 vue-router 的 getRoutes() 或配合后端 API 输出完整列表
    示例：
    <url>
      <loc>https://cncg.me/note/文章-slug</loc>
      <changefreq>monthly</changefreq>
      <priority>0.6</priority>
    </url>
  -->
</urlset>
