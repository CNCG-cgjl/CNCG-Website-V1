# Public client environment variables
# These values are bundled into the frontend and visible in the browser.
VITE_QQ_BOT_WEBHOOK=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Private server environment variables
# Never expose these to frontend code or commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# Feishu integration
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BLOG_FOLDER_ID=
FEISHU_WIKI_TOKEN=
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
# Bitable base app token, not the wiki/document token.
FEISHU_BITABLE_APP_TOKEN=
# Bitable table id in the URL query string, e.g. ?table=tblxxxxxxxx.
# Do not use the view id from ?view=vewxxxxxxxx.
FEISHU_BITABLE_TABLE_ID=

# Messaging channels
QMSG_KEY=
QQ_NUMBER=
QQ_BOT_APP_ID=
QQ_BOT_TOKEN=

# Internal service tokens
NOTIFY_TOKEN=
CRON_TOKEN=
DEPLOY_HOOK_TOKEN=

