# ========================================
# 前端环境变量（VITE_ 前缀会打包到 JS bundle）
# 注意：只有非敏感信息才使用 VITE_ 前缀
# ========================================

# Supabase（anon key 是公开的客户端密钥，设计如此）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 飞书博客文件夹 ID（非敏感信息）
VITE_FEISHU_BLOG_FOLDER_ID=

# ========================================
# 后端环境变量（在 Vercel Dashboard 中配置）
# 这些变量不会暴露到前端代码中
# ========================================

# 飞书应用凭证
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# QQ 机器人 Webhook
QQ_BOT_WEBHOOK=